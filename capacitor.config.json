{
  "appId": "br.dev.zelacity.plataforma",
  "appName": "Zelacity Plataforma",
  "webDir": "public",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK",
      "hidden": false,
      "animation": "NONE"
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#062b40"
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 600,
      "launchFadeOutDuration": 180,
      "backgroundColor": "#0a3f5e",
      "showSpinner": false
    }
  }
}
